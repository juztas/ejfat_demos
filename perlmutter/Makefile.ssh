
#
#  Makefile.ssh - EJFAT Perlmutter remote SSH execution
#
#  Yatish Kumar
#  July 2024
#------------------------------------------------------------------------------------------------

include Makefile.common

.PHONY: help receive send send_file receive_file

#------------------------------------------------------------------------------------------------
# MAKEFILE TARGETS
#------------------------------------------------------------------------------------------------

help :
	@echo "========================================================================"
	@echo "EJFAT Perlmutter Makefile - Remote SSH Execution"
	@echo "========================================================================"
	@echo ""
	@echo "USAGE:"
	@echo "  make -f Makefile.ssh <target> NODE=<nodename> [VAR=value ...]"
	@echo ""
	@echo "TARGETS:"
	@echo "  help              Display this help message"
	@echo "  send              Send test data via remote node"
	@echo "  receive           Receive data via remote node"
	@echo "  send_file         Send files via remote node"
	@echo "  receive_file      Receive files via remote node"
	@echo ""
	@echo "REQUIRED:"
	@echo "  NODE              Remote node name (e.g., nid001234)"
	@echo ""
	@echo "EXAMPLES:"
	@echo "  make -f Makefile.ssh receive NODE=nid001234"
	@echo "  make -f Makefile.ssh send NODE=nid001234 TX_RATE=1.0"
	@echo "========================================================================"

receive :
ifndef NODE
	@echo "Error: NODE variable is required for SSH execution"
	@echo "Usage: make -f Makefile.ssh receive NODE=<nodename>"
	@exit 1
endif
	EJFAT_URI=$(INSTANCE_URI) \
	IP_VERSION=$(IP_VERSION) \
	LOG_DIR=$(LOG_DIR) \
	RX_DURATION=$(RX_DURATION) \
	RX_BUFSIZE=$(RX_BUFSIZE) \
	RX_TIMEOUT=$(RX_TIMEOUT) \
	RX_CORES=$(RX_CORES) \
	RX_DEQ=$(RX_DEQ) \
	MONITOR_PORTS=$(MONITOR_PORTS) \
	MONITOR_INTERVAL=$(MONITOR_INTERVAL) \
	./receive --node $(NODE)

send :
ifndef NODE
	@echo "Error: NODE variable is required for SSH execution"
	@echo "Usage: make -f Makefile.ssh send NODE=<nodename>"
	@exit 1
endif
	EJFAT_URI=$(INSTANCE_URI) \
	IP_VERSION=$(IP_VERSION) \
	LOG_DIR=$(LOG_DIR) \
	TX_RATE=$(TX_RATE) \
	TX_LENGTH=$(TX_LENGTH) \
	NFRAMES=$(NFRAMES) \
	SEND_SOCKETS=$(SEND_SOCKETS) \
	DATA_ID=$(DATA_ID) \
	./send --node $(NODE)

receive_file :
ifndef NODE
	@echo "Error: NODE variable is required for SSH execution"
	@echo "Usage: make -f Makefile.ssh receive_file NODE=<nodename>"
	@exit 1
endif
	EJFAT_URI=$(INSTANCE_URI) \
	IP_VERSION=$(IP_VERSION) \
	LOG_DIR=$(LOG_DIR) \
	FT_EXTENSION=$(FT_EXTENSION) \
	FT_PREFIX=$(FT_PREFIX) \
	FT_TIMEOUT=$(FT_TIMEOUT) \
	FT_THREADS=$(FT_THREADS) \
	DATA_PATH=$(DATA_PATH) \
	./receive_file --node $(NODE)

send_file :
ifndef NODE
	@echo "Error: NODE variable is required for SSH execution"
	@echo "Usage: make -f Makefile.ssh send_file NODE=<nodename>"
	@exit 1
endif
	EJFAT_URI=$(INSTANCE_URI) \
	IP_VERSION=$(IP_VERSION) \
	LOG_DIR=$(LOG_DIR) \
	FT_EXTENSION=$(FT_EXTENSION) \
	FT_RATE=$(FT_RATE) \
	SEND_SOCKETS=$(FT_SOCKETS) \
	DATA_PATH=$(DATA_PATH) \
	./send_file --node $(NODE)
