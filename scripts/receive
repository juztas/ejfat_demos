#!/bin/bash
#
# receive - EJFAT Receiver Script
#
# This script starts an EJFAT receiver using configuration from a YAML file.
# It parses the YAML, generates reassembler_config.ini, and runs e2sar_perf.
#
# Usage: receive <config.yaml>
#
# Arguments:
#   config.yaml  Path to YAML configuration file
#
# Environment Variables (optional overrides):
#   WORK_DIR     Working directory (default: current directory)
#   MY_IP        IP address to bind to (default: auto-detect)
#

set -e

# Determine script directory early, before changing directories
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

#------------------------------------------------------------------------------------------------
# FUNCTIONS
#------------------------------------------------------------------------------------------------

# Function to parse YAML and extract value
parse_yaml() {
    local yaml_file="$1"
    local key="$2"
    # Simple YAML parser for key: value format
    grep "^${key}:" "$yaml_file" 2>/dev/null | sed "s/^${key}:[[:space:]]*//" | sed "s/[[:space:]]*$//" | sed "s/^['\"]//; s/['\"]$//"
}

# Function to parse instance-specific YAML with fallback to default
# Usage: parse_yaml_instance <file> <key_prefix> <instance_index>
# Tries: <key_prefix>_<index>, then falls back to <key_prefix>
# Example: parse_yaml_instance config.yaml "rx_cores" 0
#   First tries: rx_cores_0
#   Then tries:  rx_cores (default)
parse_yaml_instance() {
    local yaml_file="$1"
    local key_prefix="$2"
    local instance="$3"

    # Try instance-specific value first
    local instance_key="${key_prefix}_${instance}"
    local value=$(parse_yaml "$yaml_file" "$instance_key")

    # If not found, try default key
    if [ -z "$value" ]; then
        value=$(parse_yaml "$yaml_file" "$key_prefix")
    fi

    echo "$value"
}

# Function to calculate sender duration
# Usage: calculate_sender_duration <nframes> <tx_length_bytes> <tx_rate_gbps>
calculate_sender_duration() {
    local nframes=$1
    local tx_length=$2
    local tx_rate=$3

    # Total data in bytes
    local total_bytes=$(echo "$nframes * $tx_length" | bc)

    # Total bits
    local total_bits=$(echo "$total_bytes * 8" | bc)

    # Duration in seconds = total_bits / (rate_gbps * 10^9)
    local duration=$(echo "scale=2; $total_bits / ($tx_rate * 1000000000)" | bc)

    echo "$duration"
}

# Function to find longest sender duration from sender config
# Returns the longest duration and sets global variables for documentation
find_longest_sender_duration() {
    local sender_config="$1"

    if [ ! -f "$sender_config" ]; then
        echo "0"
        return
    fi

    # Get default values
    local default_rate=$(parse_yaml "$sender_config" "tx_rate")
    default_rate="${default_rate:-25}"
    local default_length=$(parse_yaml "$sender_config" "tx_length")
    default_length="${default_length:-2097152}"
    local default_nframes=$(parse_yaml "$sender_config" "nframes")
    default_nframes="${default_nframes:-10000}"

    local max_duration=0
    local max_instance=""
    local max_rate=""
    local max_length=""
    local max_nframes=""

    # Check up to 20 instances (should be more than enough)
    for instance in {0..19}; do
        # Get instance-specific values or defaults
        local rate=$(parse_yaml "$sender_config" "tx_rate_${instance}")
        rate="${rate:-$default_rate}"

        local length=$(parse_yaml "$sender_config" "tx_length_${instance}")
        length="${length:-$default_length}"

        local nframes=$(parse_yaml "$sender_config" "nframes_${instance}")
        nframes="${nframes:-$default_nframes}"

        # Calculate duration for this instance
        local duration=$(calculate_sender_duration "$nframes" "$length" "$rate")

        # Track the maximum
        local is_greater=$(echo "$duration > $max_duration" | bc)
        if [ "$is_greater" -eq 1 ]; then
            max_duration=$duration
            max_instance=$instance
            max_rate=$rate
            max_length=$length
            max_nframes=$nframes
        fi
    done

    # Set global variables for documentation
    LONGEST_SENDER_INSTANCE=$max_instance
    LONGEST_SENDER_RATE=$max_rate
    LONGEST_SENDER_LENGTH=$max_length
    LONGEST_SENDER_NFRAMES=$max_nframes
    LONGEST_SENDER_DURATION=$max_duration

    echo "$max_duration"
}

# Function to display help
show_help() {
    cat << EOF
Usage: receive [OPTIONS] <config.yaml>

Start an EJFAT receiver using configuration from a YAML file.

Arguments:
  config.yaml  Path to YAML configuration file

Options:
  --rx-index <n>      Receiver index number (default: 0)
  -h, --help          Show this help message

Environment Variables (optional):
  WORK_DIR     Working directory (default: current directory)
  MY_IP        IP address to bind to (default: auto-detect)

Examples:
  receive receiver_config.yaml
  receive --rx-index 0 receiver_config.yaml
  WORK_DIR=./run_output receive receiver_config.yaml

See receiver_config.yaml for configuration options.
EOF
    exit 0
}

#------------------------------------------------------------------------------------------------
# ARGUMENT PARSING
#------------------------------------------------------------------------------------------------

# Default values
RX_INDEX=0
CONFIG_FILE=""

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            ;;
        --rx-index)
            RX_INDEX="$2"
            shift 2
            continue
            ;;
        *)
            CONFIG_FILE="$1"
            shift
            break
            ;;
    esac
done

# Check for config file
if [[ -z "$CONFIG_FILE" ]]; then
    echo "Error: Configuration file not specified"
    show_help
fi

# Check if config file exists
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Error: Configuration file not found: $CONFIG_FILE"
    exit 1
fi

#------------------------------------------------------------------------------------------------
# PARSE YAML CONFIGURATION
#------------------------------------------------------------------------------------------------

echo "========================================================================"
echo "EJFAT Receiver - Parsing Configuration"
echo "========================================================================"
echo "Config file: $CONFIG_FILE"

# Instance URI configuration
INSTANCE_URI_FILE=$(parse_yaml "$CONFIG_FILE" "instance_uri_file")
INSTANCE_URI_FILE="${INSTANCE_URI_FILE:-INSTANCE_URI}"

# Network configuration
IP_VERSION=$(parse_yaml "$CONFIG_FILE" "ip_version")
IP_VERSION="${IP_VERSION:-6}"
IP_VERSION_DASH="-${IP_VERSION}"

# Receiver configuration
RX_DURATION=$(parse_yaml "$CONFIG_FILE" "rx_duration")
RX_DURATION_FROM_CONFIG="$RX_DURATION"

# Set default if not specified
if [ -z "$RX_DURATION" ]; then
    RX_DURATION=120
fi

# If rx_duration is -1, try to calculate from sender config
if [ "$RX_DURATION" = "-1" ]; then
    # Try to find sender config file
    CONFIG_DIR=$(dirname "$CONFIG_FILE")
    SENDER_CONFIG=""

    # Look for sender config in same directory
    for name in sender_config.yaml sender_config.yml; do
        if [ -f "$CONFIG_DIR/$name" ]; then
            SENDER_CONFIG="$CONFIG_DIR/$name"
            break
        fi
    done

    # If found, calculate receiver duration based on longest sender
    if [ -n "$SENDER_CONFIG" ]; then
        echo "Auto-calculating receiver duration from sender config: $SENDER_CONFIG"

        # Find longest sender duration
        LONGEST_DURATION=$(find_longest_sender_duration "$SENDER_CONFIG")

        if [ "$LONGEST_DURATION" != "0" ]; then
            # Add 30 second buffer for sender completion and cleanup
            BUFFER_SECONDS=30
            RX_DURATION=$(echo "$LONGEST_DURATION + $BUFFER_SECONDS" | bc)
            RX_DURATION=$(printf "%.0f" "$RX_DURATION")  # Round to integer

            echo "Calculated receiver duration: ${RX_DURATION}s (longest sender: ${LONGEST_DURATION}s + ${BUFFER_SECONDS}s buffer)"
            AUTO_CALCULATED_DURATION="true"
        else
            # Fallback to default if calculation failed
            echo "Warning: Auto-calculation failed, using default duration of 120s"
            RX_DURATION=120
            AUTO_CALCULATED_DURATION="false"
        fi
    else
        # No sender config found, use default
        echo "Warning: sender_config.yaml not found, using default duration of 120s"
        RX_DURATION=120
        AUTO_CALCULATED_DURATION="false"
    fi
else
    AUTO_CALCULATED_DURATION="false"
fi

RX_THREADS=$(parse_yaml "$CONFIG_FILE" "rx_threads")
RX_THREADS="${RX_THREADS:-16}"

RX_BUFSIZE=$(parse_yaml "$CONFIG_FILE" "rx_bufsize")
RX_BUFSIZE="${RX_BUFSIZE:-400000000}"

RX_TIMEOUT=$(parse_yaml "$CONFIG_FILE" "rx_timeout")
RX_TIMEOUT="${RX_TIMEOUT:-7000}"

RX_CORES=$(parse_yaml_instance "$CONFIG_FILE" "rx_cores" "$RX_INDEX")
RX_CORES="${RX_CORES:-1}"

RX_DEQ=$(parse_yaml_instance "$CONFIG_FILE" "rx_dequeue" "$RX_INDEX")
RX_DEQ="${RX_DEQ:-16}"

# Logging configuration
LOG_DIR=$(parse_yaml "$CONFIG_FILE" "log_dir")
LOG_DIR="${LOG_DIR:-./}"

# Monitoring configuration - will be updated after port calculation
MONITOR_INTERVAL=$(parse_yaml "$CONFIG_FILE" "monitor_interval")
MONITOR_INTERVAL="${MONITOR_INTERVAL:-0.1}"

# Stats reporting period for e2sar_perf receiver
STATS_PERIOD_MS=$(parse_yaml "$CONFIG_FILE" "stats_period_ms")
STATS_PERIOD_MS="${STATS_PERIOD_MS:-1000}"

MY_INTERFACE=$(parse_yaml "$CONFIG_FILE" "interface")

# Reassembler configuration
REASSEM_USE_CP=$(parse_yaml "$CONFIG_FILE" "reassem_use_cp")
REASSEM_USE_CP="${REASSEM_USE_CP:-true}"

REASSEM_VALIDATE_CERT=$(parse_yaml "$CONFIG_FILE" "reassem_validate_cert")
REASSEM_VALIDATE_CERT="${REASSEM_VALIDATE_CERT:-true}"

REASSEM_USE_HOST_ADDRESS=$(parse_yaml "$CONFIG_FILE" "reassem_use_host_address")
REASSEM_USE_HOST_ADDRESS="${REASSEM_USE_HOST_ADDRESS:-false}"

REASSEM_DATA_PORT_BASE=$(parse_yaml "$CONFIG_FILE" "reassem_data_port")
REASSEM_DATA_PORT_BASE="${REASSEM_DATA_PORT_BASE:-10000}"

# Calculate unique port for this receiver instance based on RX_INDEX and number of threads
# Port = BASE_PORT + (RX_INDEX * RX_THREADS)
# This ensures non-overlapping port ranges for multiple receivers on same host
PORT_OFFSET=$((RX_INDEX * RX_THREADS))
REASSEM_DATA_PORT=$((REASSEM_DATA_PORT_BASE + PORT_OFFSET))

# Calculate monitor port range to match the receiver's port range
# Monitor ports should cover: REASSEM_DATA_PORT to (REASSEM_DATA_PORT + RX_THREADS - 1)
MONITOR_PORTS="${REASSEM_DATA_PORT}-$((REASSEM_DATA_PORT + RX_THREADS - 1))"

REASSEM_PORT_RANGE=$(parse_yaml_instance "$CONFIG_FILE" "reassembler_port_range" "$RX_INDEX")
REASSEM_PORT_RANGE="${REASSEM_PORT_RANGE:--1}"

REASSEM_WITH_LB_HEADER=$(parse_yaml "$CONFIG_FILE" "reassem_with_lb_header")
REASSEM_WITH_LB_HEADER="${REASSEM_WITH_LB_HEADER:-false}"

REASSEM_EVENT_TIMEOUT_MS=$(parse_yaml "$CONFIG_FILE" "reassem_event_timeout_ms")
REASSEM_EVENT_TIMEOUT_MS="${REASSEM_EVENT_TIMEOUT_MS:-500}"

REASSEM_RCV_SOCKET_BUFSIZE=$(parse_yaml "$CONFIG_FILE" "reassem_rcv_socket_bufsize")
REASSEM_RCV_SOCKET_BUFSIZE="${REASSEM_RCV_SOCKET_BUFSIZE:-3145728}"

REASSEM_EPOCH_MS=$(parse_yaml "$CONFIG_FILE" "reassem_epoch_ms")
REASSEM_EPOCH_MS="${REASSEM_EPOCH_MS:-1000}"

REASSEM_PERIOD_MS=$(parse_yaml "$CONFIG_FILE" "reassem_period_ms")
REASSEM_PERIOD_MS="${REASSEM_PERIOD_MS:-100}"

# PID controller settings
REASSEM_PID_SETPOINT=$(parse_yaml "$CONFIG_FILE" "reassem_pid_setpoint")
REASSEM_PID_SETPOINT="${REASSEM_PID_SETPOINT:-0.0}"

REASSEM_PID_KI=$(parse_yaml "$CONFIG_FILE" "reassem_pid_ki")
REASSEM_PID_KI="${REASSEM_PID_KI:-0.0}"

REASSEM_PID_KP=$(parse_yaml "$CONFIG_FILE" "reassem_pid_kp")
REASSEM_PID_KP="${REASSEM_PID_KP:-0.0}"

REASSEM_PID_KD=$(parse_yaml "$CONFIG_FILE" "reassem_pid_kd")
REASSEM_PID_KD="${REASSEM_PID_KD:-0.0}"

REASSEM_PID_WEIGHT=$(parse_yaml "$CONFIG_FILE" "reassem_pid_weight")
REASSEM_PID_WEIGHT="${REASSEM_PID_WEIGHT:-1.0}"

REASSEM_PID_MIN_FACTOR=$(parse_yaml "$CONFIG_FILE" "reassem_pid_min_factor")
REASSEM_PID_MIN_FACTOR="${REASSEM_PID_MIN_FACTOR:-0.5}"

REASSEM_PID_MAX_FACTOR=$(parse_yaml "$CONFIG_FILE" "reassem_pid_max_factor")
REASSEM_PID_MAX_FACTOR="${REASSEM_PID_MAX_FACTOR:-2.0}"

#------------------------------------------------------------------------------------------------
# SETUP WORK DIRECTORY
#------------------------------------------------------------------------------------------------

# Use WORK_DIR from environment, or default to current directory
WORK_DIR="${WORK_DIR:-.}"

# Create work directory if it doesn't exist
mkdir -p "$WORK_DIR"
mkdir -p "$WORK_DIR/$LOG_DIR"

# Change to WORK_DIR so e2sar_perf can find reassembler_config.ini
cd "$WORK_DIR"

#------------------------------------------------------------------------------------------------
# AUTO-DETECT IP ADDRESS
#------------------------------------------------------------------------------------------------

if [ -z "$MY_IP" ]; then
    if [ "$IP_VERSION" = "4" ]; then
        LB_IP=$(dig +short ejfat-lb.es.net A | tail -1)
    else
        LB_IP=$(dig +short ejfat-lb.es.net AAAA | tail -1)
    fi
    MY_IP=$(ip route get $LB_IP | head -1 | sed 's/^.*src//' | awk '{ print $1 }')
fi

if [ -z "$MY_INTERFACE" ]; then
    if [ "$IP_VERSION" = "4" ]; then
        LB_IP=$(dig +short ejfat-lb.es.net A | tail -1)
    else
        LB_IP=$(dig +short ejfat-lb.es.net AAAA | tail -1)
    fi
    MY_INTERFACE=$(ip route get $LB_IP | head -1 | sed 's/^.*dev//' | awk '{ print $1 }')
fi

#------------------------------------------------------------------------------------------------
# GENERATE REASSEMBLER CONFIG
#------------------------------------------------------------------------------------------------

echo "Generating reassembler_config_rx_${RX_INDEX}.ini..."

cat > reassembler_config_rx_${RX_INDEX}.ini << EOF
; ============================================================================
; RECEIVER DURATION CALCULATION
; ============================================================================
$(if [ "$AUTO_CALCULATED_DURATION" = "true" ]; then
cat << CALC_EOF
; This receiver duration was AUTO-CALCULATED based on sender configuration.
;
; Calculation method:
;   1. Analyzed all sender instances in sender_config.yaml
;   2. Found longest sender duration across all instances
;   3. Added buffer time for sender completion and cleanup
;   4. Set receiver duration = longest_sender_duration + buffer
;
; Longest sender instance found:
;   Instance:            tx_${LONGEST_SENDER_INSTANCE}
;   Frames to send:      ${LONGEST_SENDER_NFRAMES}
;   Frame size (bytes):  ${LONGEST_SENDER_LENGTH}
;   Transmission rate:   ${LONGEST_SENDER_RATE} Gbps
;   Sender duration:     ${LONGEST_SENDER_DURATION} seconds
;
; Buffer calculation:
;   Safety buffer:       30 seconds (for sender completion + cleanup)
;
; Final receiver duration:
;   Duration:            ${RX_DURATION} seconds
;   Formula:             ${LONGEST_SENDER_DURATION}s + 30s = ${RX_DURATION}s
;
; To override this auto-calculation, set rx_duration in receiver_config.yaml
; to a positive value (0 or greater).
CALC_EOF
else
cat << MANUAL_EOF
; Receiver duration: ${RX_DURATION} seconds
; This value was manually configured in receiver_config.yaml
;
; To enable auto-calculation based on sender config, set rx_duration: -1
MANUAL_EOF
fi)
; ============================================================================

[general]
; whether to use the control plane (gRPC sendState, registerWorker)
useCP = $REASSEM_USE_CP

[control-plane]
; validate control plane TLS certificate in gRPC communications
validateCert = $REASSEM_VALIDATE_CERT
; force using address (v4 or v6) even if hostname specified in the URI
useHostAddress = $REASSEM_USE_HOST_ADDRESS

[data-plane]
; Note: dataPort is now specified via e2sar_perf -p command line option
; 2^portRange (0<=portRange<=14) listening ports will be open starting from dataPort.
; If -1, then the number of ports matches either the number of CPU cores or the number of threads. Normally
; this value is calculated based on the number of cores or threads requested, but
; it can be overridden here. Use with caution.
portRange = $REASSEM_PORT_RANGE
; expect LB header to be included (mainly for testing when withCP==false,
; as normally LB strips it off in normal operation)
withLBHeader = $REASSEM_WITH_LB_HEADER
; how long (in ms) we allow events to remain in assembly before we give up
eventTimeoutMS = $REASSEM_EVENT_TIMEOUT_MS
; socket buffer size for receiving set via SO_RCVBUF setsockopt. Note
; that this requires systemwide max set via sysctl (net.core.rmem_max) to be higher.
rcvSocketBufSize = $REASSEM_RCV_SOCKET_BUFSIZE
; period of one epoch in milliseconds
epochMS = $REASSEM_EPOCH_MS
; period of the send state thread in milliseconds
periodMS = $REASSEM_PERIOD_MS

[pid]
; setPoint queue occupied percentage to which to drive the PID controller
setPoint = $REASSEM_PID_SETPOINT
; PID gains (integral, proportional and derivative)
Ki = $REASSEM_PID_KI
Kp = $REASSEM_PID_KP
Kd = $REASSEM_PID_KD
; schedule weight parameters
weight = $REASSEM_PID_WEIGHT
; multiplied with the number of slots that would be assigned evenly to determine min number of slots
; for example, 4 nodes with a minFactor of 0.5 = (512 slots / 4) * 0.5 = min 64 slots
min_factor = $REASSEM_PID_MIN_FACTOR
; multiplied with the number of slots that would be assigned evenly to determine max number of slots
; for example, 4 nodes with a maxFactor of 2 = (512 slots / 4) * 2 = max 256 slots set to 0 to specify no maximum
max_factor = $REASSEM_PID_MAX_FACTOR
EOF

#------------------------------------------------------------------------------------------------
# DISPLAY CONFIGURATION
#------------------------------------------------------------------------------------------------

echo "========================================================================"
echo "EJFAT Receiver - Starting"
echo "========================================================================"
if [ -n "$RUN_ID" ]; then
    echo "Run ID:             $RUN_ID"
fi
echo "Receiver IP:        $MY_IP"
echo "IP Version:         IPv$IP_VERSION"
echo "Interface:          $MY_INTERFACE"
echo "Work Directory:     $WORK_DIR"
echo "Log Directory:      $LOG_DIR"
echo "Data Port:          $REASSEM_DATA_PORT (base: $REASSEM_DATA_PORT_BASE + RX_INDEX($RX_INDEX) * RX_THREADS($RX_THREADS) = $PORT_OFFSET)"
echo "Monitor Ports:      $MONITOR_PORTS ($RX_THREADS ports)"
echo "RX Duration:        $RX_DURATION sec"
echo "RX Buffer Size:     $RX_BUFSIZE bytes"
echo "RX Timeout:         $RX_TIMEOUT ms"
echo "RX Cores:           $RX_CORES"
echo "RX Dequeue:         $RX_DEQ"
echo "Monitor Interval:   $MONITOR_INTERVAL sec"
echo "Stats Period:       $STATS_PERIOD_MS ms"
echo "Use Control Plane:  $REASSEM_USE_CP"
echo "RX Index:           $RX_INDEX"
echo "========================================================================"
echo ""

#------------------------------------------------------------------------------------------------
# START UDP SOCKET MONITOR
#------------------------------------------------------------------------------------------------

# Disabled UDP socket monitor
# udp-socket-monitor.sh -p $MONITOR_PORTS -t $MONITOR_INTERVAL -o $LOG_DIR/rx_${RX_INDEX}_csvfile.csv &
# MONITOR_PID=$!

#------------------------------------------------------------------------------------------------
# SYNCHRONIZED START
#------------------------------------------------------------------------------------------------

# If START_TIME is set, wait until that time before starting e2sar_perf
if [ -n "$START_TIME" ]; then
    CURRENT_TIME=$(date +%s)
    SECONDS_TO_WAIT=$((START_TIME - CURRENT_TIME))

    echo "========================================================================"
    echo "Synchronized Start Configuration"
    echo "========================================================================"
    echo "Target start time:  $(date -u -d @$START_TIME +"%Y-%m-%d %H:%M:%S UTC" 2>/dev/null || date -u -r $START_TIME +"%Y-%m-%d %H:%M:%S UTC")"
    echo "Current time:       $(date -u +"%Y-%m-%d %H:%M:%S UTC")"
    echo "Seconds to wait:    $SECONDS_TO_WAIT seconds"
    echo "========================================================================"
    echo ""

    # Write timing debug info to log file
    {
        echo "========== RECEIVER SYNCHRONIZED START DEBUG =========="
        echo "Target start time (epoch):  $START_TIME"
        echo "Target start time (UTC):    $(date -u -d @$START_TIME +"%Y-%m-%d %H:%M:%S.%N UTC" 2>/dev/null || date -u -r $START_TIME +"%Y-%m-%d %H:%M:%S UTC")"
        echo "Current time (epoch):       $CURRENT_TIME"
        echo "Current time (UTC):         $(date -u +"%Y-%m-%d %H:%M:%S.%N UTC")"
        echo "Seconds to wait:            $SECONDS_TO_WAIT"
    } >> "$LOG_DIR/rx_${RX_INDEX}_timing_debug.log"

    if [ $SECONDS_TO_WAIT -gt 0 ]; then
        echo "Waiting $SECONDS_TO_WAIT seconds until synchronized start time..."

        # Log time just before blocking
        BEFORE_SLEEP_TIME=$(date +%s.%N)
        {
            echo "Time BEFORE sleep (epoch):  $BEFORE_SLEEP_TIME"
            echo "Time BEFORE sleep (UTC):    $(date -u +"%Y-%m-%d %H:%M:%S.%N UTC")"
        } >> "$LOG_DIR/rx_${RX_INDEX}_timing_debug.log"

        sleep $SECONDS_TO_WAIT

        # Log time just after blocking
        AFTER_SLEEP_TIME=$(date +%s.%N)
        {
            echo "Time AFTER sleep (epoch):   $AFTER_SLEEP_TIME"
            echo "Time AFTER sleep (UTC):     $(date -u +"%Y-%m-%d %H:%M:%S.%N UTC")"
            echo "Actual sleep duration:      $(echo "$AFTER_SLEEP_TIME - $BEFORE_SLEEP_TIME" | bc) seconds"
            echo "======================================================="
        } >> "$LOG_DIR/rx_${RX_INDEX}_timing_debug.log"

        echo "Starting NOW at $(date -u +"%Y-%m-%d %H:%M:%S UTC")"
        echo ""
    elif [ $SECONDS_TO_WAIT -lt -30 ]; then
        echo "WARNING: Start time was $((0 - SECONDS_TO_WAIT)) seconds ago!"
        echo "WARNING: This receiver is starting significantly late."
        {
            echo "WARNING: Starting late by $((0 - SECONDS_TO_WAIT)) seconds"
            echo "======================================================="
        } >> "$LOG_DIR/rx_${RX_INDEX}_timing_debug.log"
        echo ""
    else
        echo "Start time is now or in the recent past, starting immediately..."
        {
            echo "Starting immediately (within 30 seconds of target)"
            echo "======================================================="
        } >> "$LOG_DIR/rx_${RX_INDEX}_timing_debug.log"
        echo ""
    fi
fi

#------------------------------------------------------------------------------------------------
# RUN E2SAR_PERF RECEIVER
#------------------------------------------------------------------------------------------------

echo "========================================================================"
echo "DEBUG: Current working directory: $(pwd)"
echo "DEBUG: Contents of current directory:"
ls -la
echo "DEBUG: reassembler_config_rx_${RX_INDEX}.ini location:"
ls -la reassembler_config_rx_${RX_INDEX}.ini 2>&1
echo "DEBUG: e2sar_perf command:"
echo "e2sar_perf --recv --withcp --duration $RX_DURATION $IP_VERSION_DASH --ip $MY_IP --bufsize $RX_BUFSIZE --timeout $RX_TIMEOUT --cores $RX_CORES --deq $RX_DEQ --port $REASSEM_DATA_PORT --period $STATS_PERIOD_MS -i reassembler_config_rx_${RX_INDEX}.ini"
echo "========================================================================"
echo ""

# e2sar_perf will use the reassembler_config_rx_${RX_INDEX}.ini we generated and the --port option for dataPort
e2sar_perf --recv --withcp --duration $RX_DURATION $IP_VERSION_DASH --ip $MY_IP --bufsize $RX_BUFSIZE --timeout $RX_TIMEOUT --cores $RX_CORES --deq $RX_DEQ --port $REASSEM_DATA_PORT --period $STATS_PERIOD_MS -i reassembler_config_rx_${RX_INDEX}.ini

#------------------------------------------------------------------------------------------------
# CLEANUP
#------------------------------------------------------------------------------------------------

# Kill the UDP socket monitor (disabled)
# echo "Stopping UDP socket monitor..."
# kill -15 $MONITOR_PID 2>/dev/null || true
# sleep 1

jobs

echo ""
echo "========================================================================"
echo "Receiver completed"
echo "========================================================================"
