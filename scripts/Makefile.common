
#
#  Makefile.common - Shared configuration variables for EJFAT Perlmutter Makefiles
#
#  This file is included by Makefile.podman, Makefile.ssh, and Makefile.local
#  to maintain consistent configuration across all execution modes.
#
#  Yatish Kumar
#  July 2024
#------------------------------------------------------------------------------------------------

#------------------------------------------------------------------------------------------------
# SCRIPT AND PATH CONFIGURATION
#------------------------------------------------------------------------------------------------
# Directory containing the execution scripts (reserve, send, receive, etc.)
# Default: Same directory as this Makefile
SCRIPT_DIR ?= $(MAKEFILE_DIR)

# Working directory - where logs and output files will be written
# Default: Current directory
WORK_DIR ?= .

#------------------------------------------------------------------------------------------------
# NETWORK CONFIGURATION
#------------------------------------------------------------------------------------------------
# Accept either numeric (4, 6) or dash-prefixed (-4, -6) format
# Default to 6 (IPv6)
IP_VERSION ?= 6

# Normalize IP_VERSION to numeric format (strip dash if present)
IP_VERSION_NUMERIC := $(patsubst -%,%,$(IP_VERSION))

# Convert to dash-prefixed format for use with commands that need it
IP_VERSION_DASH := -$(IP_VERSION_NUMERIC)

ifeq ($(IP_VERSION_NUMERIC),4)
  LB_IP ?= $(shell dig +short ejfat-lb.es.net A | tail -1 )
  MY_IP ?= $(shell ip route get $(LB_IP) | head -1 | sed 's/^.*src//' | awk '{ print $$1 }')
else
  LB_IP ?= $(shell dig +short ejfat-lb.es.net AAAA | tail -1 )
  MY_IP ?= $(shell ip route get $(LB_IP) | head -1 | sed 's/^.*src//' | awk '{ print $$1 }')
endif

MY_INTERFACE ?= $(shell ip route get $(LB_IP) | head -1 | sed 's/^.*dev//' | awk '{ print $$1 }')

#------------------------------------------------------------------------------------------------
# INSTANCE URI CONFIGURATION
#------------------------------------------------------------------------------------------------
# INSTANCE_URI_FILE - Path to the file containing the INSTANCE_URI
#                     Default: INSTANCE_URI in the run directory
#                     Override with: make <target> INSTANCE_URI_FILE=/path/to/file
INSTANCE_URI_FILE ?= INSTANCE_URI
INSTANCE_URI := $(shell cat $(INSTANCE_URI_FILE) 2>/dev/null | sed "s/^[^=]*=//; s/^'//; s/'[[:space:]]*$$//")

#------------------------------------------------------------------------------------------------
# PERFORMANCE CONFIGURATION
#------------------------------------------------------------------------------------------------
RX_DURATION ?= 120
RX_THREADS ?= 16
RX_BUFSIZE ?= 400000000
RX_TIMEOUT ?= 7000
RX_CORES ?= 1
RX_DEQ ?= 16

TX_RATE ?= 0.1
TX_LENGTH ?= 2097152
SEND_SOCKETS ?= 8
NFRAMES ?= 10000
DATA_ID ?= $(shell bash -c 'echo $$(( $$RANDOM % 1000 + 1 ))')

#------------------------------------------------------------------------------------------------
# SEGMENTER CONFIGURATION
#------------------------------------------------------------------------------------------------
# Control plane settings
USE_CP ?= true
WARMUP_MS ?= 1000
SYNC_PERIOD_MS ?= 1000
SYNC_PERIODS ?= 2

# Data plane settings
CONNECTED_SOCKET ?= true
MTU ?= 0
SND_SOCKET_BUFSIZE ?= 3145728
SMOOTH ?= false
MULTI_PORT ?= false

#------------------------------------------------------------------------------------------------
# FILE TRANSFER CONFIGURATION
#------------------------------------------------------------------------------------------------
FT_EXTENSION ?= root
FT_PREFIX ?= test
FT_RATE ?= 1
FT_SOCKETS ?= 4
FT_TIMEOUT ?= 7000
FT_THREADS ?= 4
FT_NUMFILES ?= 25
FT_FILESIZE ?= 300

DATA_DIR ?= $(SCRATCH)/storage/ejfat_ft/data
DATA_RX_DIR ?= $(SCRATCH)/storage/ejfat_ft/data_rx
DATA_PATH ?= /data

#------------------------------------------------------------------------------------------------
# REASSEMBLER CONFIGURATION
#------------------------------------------------------------------------------------------------
# Control plane settings
REASSEM_USE_CP ?= true
REASSEM_VALIDATE_CERT ?= true
REASSEM_USE_HOST_ADDRESS ?= false

# Data plane settings
REASSEM_PORT_RANGE ?= -1
REASSEM_WITH_LB_HEADER ?= false
REASSEM_EVENT_TIMEOUT_MS ?= 500
REASSEM_RCV_SOCKET_BUFSIZE ?= 3145728
REASSEM_EPOCH_MS ?= 1000
REASSEM_PERIOD_MS ?= 100

# PID controller settings
REASSEM_PID_SETPOINT ?= 0.0
REASSEM_PID_KI ?= 0.0
REASSEM_PID_KP ?= 0.0
REASSEM_PID_KD ?= 0.0
REASSEM_PID_WEIGHT ?= 1.0
REASSEM_PID_MIN_FACTOR ?= 0.5
REASSEM_PID_MAX_FACTOR ?= 2.0

#------------------------------------------------------------------------------------------------
# MONITORING CONFIGURATION
#------------------------------------------------------------------------------------------------
MONITOR_PORTS ?= 10000-10015
MONITOR_INTERVAL ?= 0.1

#------------------------------------------------------------------------------------------------
# LOAD BALANCER CONFIGURATION
#------------------------------------------------------------------------------------------------
LB_RESERVE_DURATION ?= 5
LB_NAME ?= yk_testing

#------------------------------------------------------------------------------------------------
# LOGGING CONFIGURATION
#------------------------------------------------------------------------------------------------
LOG_DIR ?= ./

#------------------------------------------------------------------------------------------------
# REMOTE EXECUTION CONFIGURATION
#------------------------------------------------------------------------------------------------
NODE ?=

# Remote script directory - where scripts are located on remote node
# Default: ../scripts (relative to perlmutter working directory)
REMOTE_SCRIPT_DIR ?= ../scripts

# Remote working directory - where execution happens on remote node
# Default: ~/ejfat_demos/perlmutter
REMOTE_WORK_DIR ?= ~/ejfat_demos/perlmutter
