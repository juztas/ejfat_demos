#!/bin/bash
#
# cpu_bars - Simple horizontal CPU bar chart display
#
# Shows one bar per CPU core with utilization percentage
# Use with: watch -n 1 --color cpu_bars
#

# Bar width in characters
BAR_WIDTH=50

# Color codes
GREEN='\033[42m'
YELLOW='\033[43m'
RED='\033[41m'
RESET='\033[0m'

# Function to draw a CPU bar
draw_bar() {
    local cpu=$1
    local percent=$2
    local filled=$(awk "BEGIN {printf \"%.0f\", $percent * $BAR_WIDTH / 100}")
    local empty=$((BAR_WIDTH - filled))

    # Choose color based on usage
    local color=$GREEN
    if (( $(awk "BEGIN {print ($percent >= 80)}") )); then
        color=$RED
    elif (( $(awk "BEGIN {print ($percent >= 50)}") )); then
        color=$YELLOW
    fi

    printf "CPU%3d [" $cpu
    printf "${color}%${filled}s${RESET}" | tr ' ' '█'
    printf "%${empty}s" | tr ' ' '░'
    printf "] %5.1f%%\n" $percent
}

# Single frame output
echo "╔════════════════════════════════════════════════════════════════╗"
echo "║  $(hostname -s) CPU Utilization - $(date +'%H:%M:%S')$(printf '%*s' $((43 - ${#HOSTNAME})) '')║"
echo "╠════════════════════════════════════════════════════════════════╣"

# Get CPU stats
mpstat -P ALL 1 1 | awk '/Average:/ && $2 ~ /^[0-9]+$/ {printf "%d %.1f\n", $2, 100-$NF}' | \
while read cpu usage; do
    draw_bar $cpu $usage
done

echo "╚════════════════════════════════════════════════════════════════╝"
