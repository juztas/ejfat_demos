# Determine the directory where this Makefile is located
MAKEFILE_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

include $(MAKEFILE_DIR)Makefile.common

.PHONY: help receive send send_file receive_file monitor

#------------------------------------------------------------------------------------------------
# MAKEFILE TARGETS
#------------------------------------------------------------------------------------------------

help :
	@echo "========================================================================"
	@echo "EJFAT Perlmutter Makefile - Remote SSH Execution"
	@echo "========================================================================"
	@echo ""
	@echo "USAGE:"
	@echo "  make -f Makefile.ssh <target> NODE=<nodename> [VAR=value ...]"
	@echo ""
	@echo "TARGETS:"
	@echo "  help              Display this help message"
	@echo "  send              Send test data via remote node"
	@echo "  receive           Receive data via remote node"
	@echo "  send_file         Send files via remote node"
	@echo "  receive_file      Receive files via remote node"
	@echo ""
	@echo "REQUIRED:"
	@echo "  NODE              Remote node name (e.g., nid001234)"
	@echo ""
	@echo "EXAMPLES:"
	@echo "  make -f Makefile.ssh receive NODE=nid001234"
	@echo "  make -f Makefile.ssh send NODE=nid001234 TX_RATE=1.0"
	@echo "========================================================================"

receive :
ifndef NODE
	@echo "Error: NODE variable is required for SSH execution"
	@echo "Usage: make -f Makefile.ssh receive NODE=<nodename>"
	@exit 1
endif
	@echo "Copying INSTANCE_URI to $(NODE):$(REMOTE_WORK_DIR)..."
	scp INSTANCE_URI $(NODE):$(REMOTE_WORK_DIR)/
	ssh -t $(NODE) 'bash -i -c '\''conda activate e2sar && cd $(REMOTE_WORK_DIR) && make -f ../scripts/Makefile.local receive SCRIPT_DIR="$(REMOTE_SCRIPT_DIR)" WORK_DIR="$(REMOTE_WORK_DIR)" IP_VERSION="$(IP_VERSION)" LOG_DIR="$(LOG_DIR)" RX_DURATION="$(RX_DURATION)" RX_BUFSIZE="$(RX_BUFSIZE)" RX_TIMEOUT="$(RX_TIMEOUT)" RX_CORES="$(RX_CORES)" RX_DEQ="$(RX_DEQ)" MONITOR_PORTS="$(MONITOR_PORTS)" MONITOR_INTERVAL="$(MONITOR_INTERVAL)" REASSEM_USE_CP="$(REASSEM_USE_CP)" REASSEM_VALIDATE_CERT="$(REASSEM_VALIDATE_CERT)" REASSEM_USE_HOST_ADDRESS="$(REASSEM_USE_HOST_ADDRESS)" REASSEM_PORT_RANGE="$(REASSEM_PORT_RANGE)" REASSEM_WITH_LB_HEADER="$(REASSEM_WITH_LB_HEADER)" REASSEM_EVENT_TIMEOUT_MS="$(REASSEM_EVENT_TIMEOUT_MS)" REASSEM_RCV_SOCKET_BUFSIZE="$(REASSEM_RCV_SOCKET_BUFSIZE)" REASSEM_EPOCH_MS="$(REASSEM_EPOCH_MS)" REASSEM_PERIOD_MS="$(REASSEM_PERIOD_MS)" REASSEM_PID_SETPOINT="$(REASSEM_PID_SETPOINT)" REASSEM_PID_KI="$(REASSEM_PID_KI)" REASSEM_PID_KP="$(REASSEM_PID_KP)" REASSEM_PID_KD="$(REASSEM_PID_KD)" REASSEM_PID_WEIGHT="$(REASSEM_PID_WEIGHT)" REASSEM_PID_MIN_FACTOR="$(REASSEM_PID_MIN_FACTOR)" REASSEM_PID_MAX_FACTOR="$(REASSEM_PID_MAX_FACTOR)"'\'''

send :
ifndef NODE
	@echo "Error: NODE variable is required for SSH execution"
	@echo "Usage: make -f Makefile.ssh send NODE=<nodename>"
	@exit 1
endif
	@echo "Copying INSTANCE_URI to $(NODE):$(REMOTE_WORK_DIR)..."
	scp INSTANCE_URI $(NODE):$(REMOTE_WORK_DIR)/
	ssh -t $(NODE) 'bash -i -c '\''conda activate e2sar && cd $(REMOTE_WORK_DIR) && make -f ../scripts/Makefile.local send SCRIPT_DIR="$(REMOTE_SCRIPT_DIR)" WORK_DIR="$(REMOTE_WORK_DIR)" IP_VERSION="$(IP_VERSION)" LOG_DIR="$(LOG_DIR)" TX_RATE="$(TX_RATE)" TX_LENGTH="$(TX_LENGTH)" NFRAMES="$(NFRAMES)" SEND_SOCKETS="$(SEND_SOCKETS)" DATA_ID="$(DATA_ID)" USE_CP="$(USE_CP)" WARMUP_MS="$(WARMUP_MS)" SYNC_PERIOD_MS="$(SYNC_PERIOD_MS)" SYNC_PERIODS="$(SYNC_PERIODS)" CONNECTED_SOCKET="$(CONNECTED_SOCKET)" MTU="$(MTU)" SND_SOCKET_BUFSIZE="$(SND_SOCKET_BUFSIZE)" SMOOTH="$(SMOOTH)" MULTI_PORT="$(MULTI_PORT)"'\'''

receive_file :
ifndef NODE
	@echo "Error: NODE variable is required for SSH execution"
	@echo "Usage: make -f Makefile.ssh receive_file NODE=<nodename>"
	@exit 1
endif
	@echo "Copying INSTANCE_URI to $(NODE):$(REMOTE_WORK_DIR)..."
	scp INSTANCE_URI $(NODE):$(REMOTE_WORK_DIR)/
	ssh -t $(NODE) 'bash -i -c '\''conda activate e2sar && cd $(REMOTE_WORK_DIR) && make -f ../scripts/Makefile.local receive_file SCRIPT_DIR="$(REMOTE_SCRIPT_DIR)" IP_VERSION="$(IP_VERSION)" LOG_DIR="$(LOG_DIR)" FT_EXTENSION="$(FT_EXTENSION)" FT_PREFIX="$(FT_PREFIX)" FT_TIMEOUT="$(FT_TIMEOUT)" FT_THREADS="$(FT_THREADS)" DATA_PATH="$(DATA_PATH)"'\'''

send_file :
ifndef NODE
	@echo "Error: NODE variable is required for SSH execution"
	@echo "Usage: make -f Makefile.ssh send_file NODE=<nodename>"
	@exit 1
endif
	@echo "Copying INSTANCE_URI to $(NODE):$(REMOTE_WORK_DIR)..."
	scp INSTANCE_URI $(NODE):$(REMOTE_WORK_DIR)/
	ssh -t $(NODE) 'bash -i -c '\''conda activate e2sar && cd $(REMOTE_WORK_DIR) && make -f ../scripts/Makefile.local send_file SCRIPT_DIR="$(REMOTE_SCRIPT_DIR)" IP_VERSION="$(IP_VERSION)" LOG_DIR="$(LOG_DIR)" FT_EXTENSION="$(FT_EXTENSION)" FT_RATE="$(FT_RATE)" SEND_SOCKETS="$(FT_SOCKETS)" DATA_PATH="$(DATA_PATH)"'\'''

monitor :
ifndef NODE
	@echo "Error: NODE variable is required for SSH execution"
	@echo "Usage: make -f Makefile.ssh monitor NODE=<nodename>"
	@exit 1
endif
	@ssh $(NODE) 'bash -i -c '\''conda activate e2sar && cd $(REMOTE_WORK_DIR) && make -f ../scripts/Makefile.local monitor SCRIPT_DIR="$(REMOTE_SCRIPT_DIR)" IP_VERSION="$(IP_VERSION)"'\'''
