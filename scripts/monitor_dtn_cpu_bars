#!/bin/bash
#
# monitor_dtn_cpu_bars - Monitor CPU utilization across DTN nodes using htop
#
# Uses tmux to display multiple hosts in horizontal layout.
#
# Usage: monitor_dtn_cpu_bars [host1 host2 ...]
#        If no hosts specified, monitors default DTN nodes
#

# Use system tmux to avoid conda environment issues
TMUX=/opt/homebrew/bin/tmux

# Get hosts from command line or use defaults
if [ $# -gt 0 ]; then
    HOSTS=("$@")
else
    # Default DTN nodes
    HOSTS=(
        "wash-dtn1-mgt.es.net"
        "star-dtn1-mgt.es.net"
        "cern773-dtn1-mgt.es.net"
        "hous-dtn1-mgt.es.net"
        "sunn-dtn1-mgt.es.net"
        "denv-dtn1-mgt.es.net"
    )
fi

SESSION="dtn-cpu-bars"

# Kill existing session if it exists
$TMUX has-session -t $SESSION 2>/dev/null && $TMUX kill-session -t $SESSION

# Create new tmux session with first host
echo "Creating tmux session with ${#HOSTS[@]} hosts in horizontal layout..."
$TMUX new-session -d -s $SESSION "ssh ${HOSTS[0]} htop" || {
    echo "Error: Failed to create tmux session (exit code: $?)"
    exit 1
}

# Give the session a moment to initialize
sleep 0.5

# Verify session was created
if ! $TMUX has-session -t $SESSION 2>/dev/null; then
    echo "Error: Session creation appeared to succeed but session doesn't exist"
    echo "This may happen if the SSH connection fails immediately"
    echo "Try running: ssh ${HOSTS[0]} htop manually to debug"
    exit 1
fi

# Split horizontally to create columns (all in one row)
for ((i=1; i<${#HOSTS[@]}; i++)); do
    $TMUX split-window -h -t $SESSION "ssh ${HOSTS[$i]} htop"
    $TMUX select-layout -t $SESSION even-horizontal
done

# Set pane titles
for ((i=0; i<${#HOSTS[@]}; i++)); do
    hostname=$(echo ${HOSTS[$i]} | cut -d'-' -f1)
    $TMUX select-pane -t $SESSION:0.$i -T "$hostname"
done

# Enable pane titles
$TMUX set-option -t $SESSION pane-border-status top
$TMUX set-option -t $SESSION pane-border-format "#{pane_title}"

# Attach to the session
echo "Attaching to session '$SESSION'..."
echo ""
echo "tmux Controls:"
echo "  Ctrl-b ←/→    Navigate between panes"
echo "  Ctrl-b d      Detach (keeps running)"
echo "  Ctrl-b x      Close current pane"
echo "  Ctrl-b z      Zoom current pane (toggle fullscreen)"
echo ""
sleep 1
$TMUX attach-session -t $SESSION
