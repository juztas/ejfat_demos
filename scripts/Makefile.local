# Determine the directory where this Makefile is located
MAKEFILE_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

include $(MAKEFILE_DIR)Makefile.common

.PHONY: help reserve free receive send monitor send_file receive_file gen_test_files

#------------------------------------------------------------------------------------------------
# MAKEFILE TARGETS
#------------------------------------------------------------------------------------------------

help :
	@echo "========================================================================"
	@echo "EJFAT Perlmutter Makefile - Local Native Execution"
	@echo "========================================================================"
	@echo ""
	@echo "TARGETS:"
	@echo "  help              Display this help message"
	@echo "  reserve           Reserve a load balancer instance"
	@echo "  free              Free the current load balancer reservation"
	@echo "  send              Send test data through the load balancer"
	@echo "  receive           Receive data from the load balancer"
	@echo "  send_file         Send files through the load balancer"
	@echo "  receive_file      Receive files from the load balancer"
	@echo "  gen_test_files    Generate test files for file transfer"
	@echo "  monitor           Monitor load balancer statistics"
	@echo ""
	@echo "USAGE:"
	@echo "  make -f Makefile.local <target> [VAR=value ...]"
	@echo ""
	@echo "EXAMPLES:"
	@echo "  make -f Makefile.local receive RX_DURATION=60"
	@echo "  make -f Makefile.local send TX_RATE=1.0"
	@echo "========================================================================"

reserve :
	@bash -c 'export EJFAT_URI_BETA="$(EJFAT_URI_BETA)"; export IP_VERSION="$(IP_VERSION_DASH)"; export LB_RESERVE_DURATION="$(LB_RESERVE_DURATION)"; export LB_NAME="$(LB_NAME)"; ./reserve | grep "EJFAT_URI" > $(INSTANCE_URI_FILE)'

receive :
	@bash -c 'export EJFAT_URI="$(INSTANCE_URI)"; export IP_VERSION="$(IP_VERSION_DASH)"; export LOG_DIR="$(LOG_DIR)"; export MY_INTERFACE="$(MY_INTERFACE)"; export RX_DURATION="$(RX_DURATION)"; export RX_BUFSIZE="$(RX_BUFSIZE)"; export RX_TIMEOUT="$(RX_TIMEOUT)"; export RX_CORES="$(RX_CORES)"; export RX_DEQ="$(RX_DEQ)"; export MONITOR_PORTS="$(MONITOR_PORTS)"; export MONITOR_INTERVAL="$(MONITOR_INTERVAL)"; export REASSEM_USE_CP="$(REASSEM_USE_CP)"; export REASSEM_VALIDATE_CERT="$(REASSEM_VALIDATE_CERT)"; export REASSEM_USE_HOST_ADDRESS="$(REASSEM_USE_HOST_ADDRESS)"; export REASSEM_PORT_RANGE="$(REASSEM_PORT_RANGE)"; export REASSEM_WITH_LB_HEADER="$(REASSEM_WITH_LB_HEADER)"; export REASSEM_EVENT_TIMEOUT_MS="$(REASSEM_EVENT_TIMEOUT_MS)"; export REASSEM_RCV_SOCKET_BUFSIZE="$(REASSEM_RCV_SOCKET_BUFSIZE)"; export REASSEM_EPOCH_MS="$(REASSEM_EPOCH_MS)"; export REASSEM_PERIOD_MS="$(REASSEM_PERIOD_MS)"; export REASSEM_PID_SETPOINT="$(REASSEM_PID_SETPOINT)"; export REASSEM_PID_KI="$(REASSEM_PID_KI)"; export REASSEM_PID_KP="$(REASSEM_PID_KP)"; export REASSEM_PID_KD="$(REASSEM_PID_KD)"; export REASSEM_PID_WEIGHT="$(REASSEM_PID_WEIGHT)"; export REASSEM_PID_MIN_FACTOR="$(REASSEM_PID_MIN_FACTOR)"; export REASSEM_PID_MAX_FACTOR="$(REASSEM_PID_MAX_FACTOR)"; ./receive'

send :
	@bash -c 'export EJFAT_URI="$(INSTANCE_URI)"; export IP_VERSION="$(IP_VERSION_DASH)"; export TX_RATE="$(TX_RATE)"; export TX_LENGTH="$(TX_LENGTH)"; export NFRAMES="$(NFRAMES)"; export SEND_SOCKETS="$(SEND_SOCKETS)"; export DATA_ID="$(DATA_ID)"; export USE_CP="$(USE_CP)"; export WARMUP_MS="$(WARMUP_MS)"; export SYNC_PERIOD_MS="$(SYNC_PERIOD_MS)"; export SYNC_PERIODS="$(SYNC_PERIODS)"; export CONNECTED_SOCKET="$(CONNECTED_SOCKET)"; export MTU="$(MTU)"; export SND_SOCKET_BUFSIZE="$(SND_SOCKET_BUFSIZE)"; export SMOOTH="$(SMOOTH)"; export MULTI_PORT="$(MULTI_PORT)"; ./send'

gen_test_files :
	generate-random-files.sh -s $(FT_FILESIZE) -p $(FT_PREFIX) -e $(FT_EXTENSION) -d $(DATA_PATH) -n $(FT_NUMFILES)

receive_file :
	@bash -c 'export EJFAT_URI="$(INSTANCE_URI)"; export IP_VERSION="$(IP_VERSION_DASH)"; export FT_EXTENSION="$(FT_EXTENSION)"; export FT_PREFIX="$(FT_PREFIX)"; export FT_TIMEOUT="$(FT_TIMEOUT)"; export FT_THREADS="$(FT_THREADS)"; export DATA_PATH="$(DATA_PATH)"; ./receive_file'

send_file :
	@bash -c 'export EJFAT_URI="$(INSTANCE_URI)"; export IP_VERSION="$(IP_VERSION_DASH)"; export FT_EXTENSION="$(FT_EXTENSION)"; export FT_RATE="$(FT_RATE)"; export SEND_SOCKETS="$(FT_SOCKETS)"; export DATA_PATH="$(DATA_PATH)"; ./send_file'

monitor :
	@bash -c 'export EJFAT_URI="$(INSTANCE_URI)"; export IP_VERSION="$(IP_VERSION_DASH)"; ./monitor'

free :
	@bash -c 'export EJFAT_URI="$(INSTANCE_URI)"; export IP_VERSION="$(IP_VERSION_DASH)"; ./free'
