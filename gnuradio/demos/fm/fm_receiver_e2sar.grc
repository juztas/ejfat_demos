options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Receives FM signal from E2SAR reassembler and demodulates
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: .:.
    id: fm_receiver_e2sar
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: FM Receiver (E2SAR Reassembler)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: audio_rate
  id: variable
  parameters:
    comment: ''
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [264, 16.0]
    rotation: 0
    state: enabled
- name: channel_rate
  id: variable
  parameters:
    comment: ''
    value: samp_rate/5
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [344, 16.0]
    rotation: 0
    state: enabled
- name: data_ip
  id: variable
  parameters:
    comment: Local IP for receiving data packets
    value: '"127.0.0.1"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 16.0]
    rotation: 0
    state: enabled
- name: ejfat_uri
  id: variable
  parameters:
    comment: EJFAT URI for E2SAR connection
    value: '"ejfat://useless@192.168.100.1:9876/lb/1?sync=192.168.0.1:12345&data=127.0.0.1"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 16.0]
    rotation: 0
    state: enabled
- name: fm_freq
  id: variable
  parameters:
    comment: ''
    value: '88.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 16.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '2400000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 16.0]
    rotation: 0
    state: enabled
- name: starting_port
  id: variable
  parameters:
    comment: Starting port for receiving E2SAR packets
    value: '19522'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 16.0]
    rotation: 0
    state: enabled
- name: vlen
  id: variable
  parameters:
    comment: Vector length - must match transmitter
    value: '8192'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 16.0]
    rotation: 0
    state: enabled
- name: volume
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Volume
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.1'
    stop: '10'
    value: '1'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 12.0]
    rotation: 0
    state: enabled
- name: xmlrpc_server_0
  id: xmlrpc_server
  parameters:
    addr: localhost
    alias: ''
    comment: 'XML-RPC Server for remote control

      Port 8081 (detector uses 8080)'
    port: '8081'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 12.0]
    rotation: 0
    state: enabled
- name: snippet_wav_control
  id: snippet
  parameters:
    alias: ''
    code: "import pmt\n\ndef set_wav_filename(self, filename):\n    \"\"\"Send filename\
      \ message to switchable WAV sink.\"\"\"\n    msg = pmt.intern(filename)\n  \
      \  self.switchable_wav_sink_0.to_basic_block()._post(pmt.intern('filename'),\
      \ msg)\n    return True\n\nself.set_wav_filename = lambda filename: set_wav_filename(self,\
      \ filename)"
    comment: 'Adds set_wav_filename() method

      Callable via XML-RPC to switch output files'
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 100.0]
    rotation: 0
    state: enabled
- name: analog_wfm_rcv_pll_0
  id: analog_wfm_rcv_pll
  parameters:
    affinity: ''
    alias: ''
    audio_decimation: '10'
    comment: 'Stereo FM Demodulator with PLL

      Outputs: 0=Left, 1=Right'
    deemph_tau: 75e-6
    maxoutbuf: '0'
    minoutbuf: '0'
    quad_rate: channel_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 132.0]
    rotation: 0
    state: enabled
- name: audio_sink_0
  id: audio_sink
  parameters:
    affinity: ''
    alias: ''
    comment: Stereo Audio Output
    device_name: ''
    num_inputs: '2'
    ok_to_block: 'True'
    samp_rate: audio_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [808, 124.0]
    rotation: 0
    state: enabled
- name: blocks_multiply_const_vxx_0
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: Left Channel Volume
    const: volume
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [608, 116.0]
    rotation: 0
    state: enabled
- name: blocks_multiply_const_vxx_1
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: Right Channel Volume
    const: volume
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [608, 180.0]
    rotation: 0
    state: enabled
- name: blocks_vector_to_stream_0
  id: blocks_vector_to_stream
  parameters:
    affinity: ''
    alias: ''
    comment: Convert vectors from E2SAR to stream
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: vlen
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [72, 260.0]
    rotation: 0
    state: enabled
- name: switchable_wav_sink_0
  id: epy_block
  parameters:
    _source_code: "import sys\nsys.path.append('.')\nfrom switchable_wav_sink import\
      \ switchable_wav_sink\n"
    affinity: ''
    alias: ''
    channels: '2'
    comment: 'Custom WAV sink that switches files via messages

      Send filename via XML-RPC'
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: audio_rate
  states:
    _io_cache: ('switchable WAV File Sink', 'switchable_wav_sink', [('sample_rate',
      '48000'), ('channels', '2')], [('0', 'float', 1), ('1', 'float', 1)], [('filename',
      'message', 1)], '', ['channels', 'sample_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 208.0]
    rotation: 0
    state: enabled
- name: ejfat_e2sar_reassembler_source_0
  id: ejfat_e2sar_reassembler_source
  parameters:
    affinity: ''
    alias: ''
    comment: E2SAR Reassembler - receives and reassembles EJFAT packets
    data_ip: data_ip
    epoch_ms: '1000'
    event_timeout_ms: '5000'
    kd: '0.0'
    ki: '0.0'
    kp: '0.0'
    max_factor: '2.0'
    maxoutbuf: '0'
    min_factor: '0.5'
    minoutbuf: '0'
    num_recv_threads: '1'
    period_ms: '100'
    port_range: '-1'
    rcv_socket_buf_size: '3145728'
    set_point: '0.0'
    starting_port: starting_port
    uri: ejfat_uri
    use_cp: 'False'
    use_host_address: 'False'
    validate_cert: 'True'
    vector_size: vlen
    weight: '1.0'
    with_lb_header: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 100.0]
    rotation: 0
    state: enabled
- name: qtgui_freq_sink_x_0
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
