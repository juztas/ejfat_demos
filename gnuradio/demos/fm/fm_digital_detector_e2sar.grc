options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: FM receiver with digital sideband detection and E2SAR streaming
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: .:.
    id: fm_digital_detector_e2sar
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: FM Digital Sideband Detector (SDR to E2SAR)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 16.0]
    rotation: 0
    state: enabled

blocks:
- name: data_id
  id: variable
  parameters:
    comment: E2SAR data ID
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 24.0]
    rotation: 0
    state: enabled
- name: digital_indicator
  id: variable_function_probe
  parameters:
    block_id: blocks_probe_signal_0
    comment: Digital FM indicator for XML-RPC access
    function_args: ''
    function_name: level
    poll_rate: '10'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1296, 24.0]
    rotation: 0
    state: enabled
- name: digital_threshold
  id: variable
  parameters:
    comment: Threshold for digital detection (dB)
    value: '-20'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1048, 24.0]
    rotation: 0
    state: enabled
- name: ejfat_uri
  id: variable
  parameters:
    comment: EJFAT URI for E2SAR connection (direct connection, no LB)
    value: '"ejfat://127.0.0.1:19522/lb/1?data=127.0.0.1:19522"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [856, 24.0]
    rotation: 0
    state: enabled
- name: energy_avg_len
  id: variable
  parameters:
    comment: Moving average length for energy smoothing
    value: '10000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1168, 24.0]
    rotation: 0
    state: enabled
- name: event_src_id
  id: variable
  parameters:
    comment: E2SAR event source ID
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [768, 24.0]
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: 'Ottawa: 106.1 CHEZ (HD Radio)'
    value: 106.1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [464, 24.0]
    rotation: 0
    state: enabled
- name: lower_sideband_center
  id: variable
  parameters:
    comment: HD Radio lower sideband center frequency offset
    value: '-165000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [128, 928.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '2400000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 24.0]
    rotation: 0
    state: enabled
- name: sideband_bw
  id: variable
  parameters:
    comment: HD Radio sideband bandwidth
    value: '70000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [344, 928.0]
    rotation: 0
    state: enabled
- name: signal_level
  id: variable_function_probe
  parameters:
    block_id: blocks_probe_signal_1
    comment: Analog FM signal level for XML-RPC access
    function_args: ''
    function_name: level
    poll_rate: '10'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1296, 104.0]
    rotation: 0
    state: enabled
- name: upper_sideband_center
  id: variable
  parameters:
    comment: HD Radio upper sideband center frequency offset
    value: '165000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 928.0]
    rotation: 0
    state: enabled
- name: vlen
  id: variable
  parameters:
    comment: Vector length - must match receiver
    value: '8192'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [264, 24.0]
    rotation: 0
    state: enabled
- name: band_pass_filter_lower
  id: band_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: Lower digital sideband bandpass
    decim: '1'
    gain: '1'
    high_cutoff_freq: lower_sideband_center + sideband_bw/2
    interp: '1'
    low_cutoff_freq: lower_sideband_center - sideband_bw/2
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_ccc
    width: '5000'
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 656.0]
    rotation: 0
    state: enabled
- name: band_pass_filter_upper
  id: band_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: Upper digital sideband bandpass
    decim: '1'
    gain: '1'
    high_cutoff_freq: upper_sideband_center + sideband_bw/2
    interp: '1'
    low_cutoff_freq: upper_sideband_center - sideband_bw/2
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_ccc
    width: '5000'
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 768.0]
    rotation: 0
    state: enabled
- name: blocks_complex_to_mag_squared_0
  id: blocks_complex_to_mag_squared
  parameters:
    affinity: ''
    alias: ''
    comment: Convert lower sideband to power
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 684.0]
    rotation: 0
    state: enabled
- name: blocks_complex_to_mag_squared_1
  id: blocks_complex_to_mag_squared
  parameters:
    affinity: ''
    alias: ''
    comment: Convert upper sideband to power
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 796.0]
    rotation: 0
    state: enabled
- name: blocks_complex_to_mag_squared_2
  id: blocks_complex_to_mag_squared
  parameters:
    affinity: ''
    alias: ''
    comment: Convert analog FM signal to power
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [472, 876.0]
    rotation: 0
    state: enabled
- name: blocks_divide_xx_0
  id: blocks_divide_xx
  parameters:
    affinity: ''
    alias: ''
    comment: Lower sideband / FM ratio
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [920, 680.0]
    rotation: 0
    state: enabled
- name: blocks_divide_xx_1
  id: blocks_divide_xx
  parameters:
    affinity: ''
    alias: ''
    comment: Upper sideband / FM ratio
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [920, 804.0]
    rotation: 0
    state: enabled
- name: blocks_max_xx_0
  id: blocks_max_xx
  parameters:
    affinity: ''
    alias: ''
    comment: Digital if either sideband detected (max of both)
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
    vlen_out: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1504, 716.0]
    rotation: 0
    state: enabled
- name: blocks_moving_average_0
  id: blocks_moving_average_xx
  parameters:
    affinity: ''
    alias: ''
    comment: Smooth lower sideband power
    length: energy_avg_len
    max_iter: '4000'
    maxoutbuf: '0'
    minoutbuf: '0'
    scale: 1.0/energy_avg_len
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 672.0]
    rotation: 0
    state: enabled
- name: blocks_moving_average_1
  id: blocks_moving_average_xx
  parameters:
    affinity: ''
    alias: ''
    comment: Smooth upper sideband power
    length: energy_avg_len
    max_iter: '4000'
    maxoutbuf: '0'
    minoutbuf: '0'
    scale: 1.0/energy_avg_len
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 784.0]
    rotation: 0
    state: enabled
- name: blocks_moving_average_2
  id: blocks_moving_average_xx
  parameters:
    affinity: ''
    alias: ''
    comment: Smooth analog FM power
    length: energy_avg_len
    max_iter: '4000'
    maxoutbuf: '0'
    minoutbuf: '0'
    scale: 1.0/energy_avg_len
    type: float
    vlen: '1'
  states:
