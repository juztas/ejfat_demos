connections:
# SHM Test connections
- [analog_noise_source_x_0, '0', blocks_throttle_0, '0']
- [blocks_throttle_0, '0', blocks_stream_to_vector_0, '0']
- [blocks_stream_to_vector_0, '0', ejfat_ejfat_shm_sink_0, '0']
- [ejfat_ejfat_shm_source_0, '0', blocks_vector_to_stream_0, '0']
- [blocks_vector_to_stream_0, '0', qtgui_freq_sink_shm, '0']
- [blocks_vector_to_stream_0, '0', qtgui_time_sink_shm, '0']

# E2SAR Test connections
- [analog_noise_source_x_1, '0', blocks_throttle_1, '0']
- [blocks_throttle_1, '0', blocks_stream_to_vector_1, '0']
- [blocks_stream_to_vector_1, '0', ejfat_e2sar_segmenter_sink_0, '0']
- [ejfat_e2sar_reassembler_source_0, '0', blocks_vector_to_stream_1, '0']
- [blocks_vector_to_stream_1, '0', qtgui_freq_sink_e2sar, '0']
- [blocks_vector_to_stream_1, '0', qtgui_time_sink_e2sar, '0']

metadata:
  file_format: 1
  grc_version: 3.10.5.1
