options:
  parameters:
    author: EJFAT Demos
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Test and demonstrate all EJFAT blocks with random data
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: .:.
    id: ejfat_blocks_test
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: EJFAT Blocks Test & Demo
    window_size: (1600,1200)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
# Variables
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled

- name: vlen
  id: variable
  parameters:
    comment: 'Vector length for testing'
    value: '1024'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 12]
    rotation: 0
    state: enabled

- name: shm_capacity
  id: variable
  parameters:
    comment: 'Shared memory FIFO capacity'
    value: '1024'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 12]
    rotation: 0
    state: enabled

- name: shm_entry_size
  id: variable
  parameters:
    comment: 'Bytes per entry (8 bytes/sample * vlen + metadata)'
    value: int(vlen * 8 + 64)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [504, 12]
    rotation: 0
    state: enabled

# =============================================================================
# Test 1: Shared Memory Blocks
# Random Source -> Stream to Vector -> SHM Sink -> SHM Source -> Vector to Stream -> Display
# =============================================================================

- name: note_shm_test
  id: note
  parameters:
    alias: ''
    comment: ''
    note: 'TEST 1: Shared Memory (SHM) Transport'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 108]
    rotation: 0
    state: true

- name: analog_noise_source_x_0
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1'
    comment: 'Random complex samples for SHM test'
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: analog.GR_GAUSSIAN
    seed: '0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 164]
    rotation: 0
    state: true

- name: blocks_throttle_0
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 180]
    rotation: 0
    state: true

- name: blocks_stream_to_vector_0
  id: blocks_stream_to_vector
  parameters:
    affinity: ''
    alias: ''
    comment: 'Convert to vectors for SHM sink'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: vlen
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [432, 188]
    rotation: 0
    state: true

- name: ejfat_ejfat_shm_sink_0
  id: ejfat_ejfat_shm_sink
  parameters:
    affinity: ''
    alias: ''
    capacity: shm_capacity
    comment: 'Write vectors to shared memory'
    entry_size: shm_entry_size
    maxoutbuf: '0'
    minoutbuf: '0'
    shm_name: ejfat_test_fifo
    vlen: vlen
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 164]
    rotation: 0
    state: true

- name: ejfat_ejfat_shm_source_0
  id: ejfat_ejfat_shm_source
  parameters:
    affinity: ''
    alias: ''
    comment: 'Read vectors from shared memory'
    maxoutbuf: '0'
    minoutbuf: '0'
    shm_name: ejfat_test_fifo
    timeout: '1.0'
    vlen: vlen
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [872, 172]
    rotation: 0
    state: true

- name: blocks_vector_to_stream_0
  id: blocks_vector_to_stream
  parameters:
    affinity: ''
    alias: ''
    comment: 'Convert back to stream for display'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: vlen
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1096, 188]
    rotation: 0
    state: true

